# ===================================================
# 🐜 DIESEL ROOM — VK Mini App программы лояльности
# ===================================================
# 1. cp .env.example .env
# 2. Заполните ключи VK и пароли
# 3. docker compose up -d --build
# ===================================================

# 🔑 VK Mini App и сообщество (https://vk.ru/diesel_room, ID 34613849)
VK_APP_ID=
VK_GROUP_ID=34613849
VK_PROTECTED_KEY=
# Токен сообщества с правом «сообщения»: брони (гостю и персоналу), уведомления рейтинга, визиты, проверка заданий.
# В Callback API группы включите события: wall_reply_new, like_add, wall_repost, group_join, message_allow, poll_vote_new.
VK_COMMUNITY_TOKEN=
VK_CALLBACK_CONFIRMATION_CODE=
VK_CALLBACK_SECRET_KEY=
# Ссылка на мини-приложение для реферальных приглашений (#ref=номер карты)
VITE_VK_APP_URL=https://vk.ru/app00000000

# 👥 Роли: администраторы (владелец Стас, арт-директор Фёдор) и сотрудники по VK ID, через запятую.
# Остальных сотрудников (с ПИН-кодами для общего планшета) администратор заводит в приложении.
VK_ADMIN_IDS=
VK_STAFF_IDS=
# Мастер-ключ администратора: не короче 12 символов; пусто — вход по ключу выключен
DIESEL_MASTER_KEY=
# Секрет для отпечатков ПИН-кодов сотрудников и кодов привилегий (любая длинная случайная строка; не менять после запуска)
DIESEL_PIN_PEPPER=

# 🐘 PostgreSQL 16
DB_USER=diesel_admin
DB_PASSWORD=
DB_NAME=diesel_room_db

# 🌐 Порты на 127.0.0.1
DB_PORT=5449
API_PORT=5062
CLIENT_PORT=3010
